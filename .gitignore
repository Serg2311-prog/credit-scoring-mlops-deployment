# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Local data and heavy artifacts
data/raw/*.csv
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep
!models/model_registry.json
artifacts/*
!artifacts/.gitkeep
!artifacts/baseline_metrics.json
mlruns/
mlartifacts/
.onnx_cache/

# Secrets / local env
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Terraform / IaC local state and secrets
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Keep .terraform.lock.hcl in Git after init for reproducible provider versions.

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Docker / local compose overrides
docker-compose.override.yml

# Local portable tooling (kind.exe, terraform.exe, etc.)
tools/
!tools/.gitkeep

# Audit copy of source (not part of deliverable)
_source_audit/
