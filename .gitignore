# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Local data and heavy artifacts
data/raw/*.csv
data/processed/*
!data/processed/.gitkeep
data/dvc_tracked/*
!data/dvc_tracked/.gitkeep
!data/dvc_tracked/*.dvc
!data/dvc_tracked/.gitignore
models/*
!models/.gitkeep
!models/model_registry.json
artifacts/*
!artifacts/.gitkeep
!artifacts/baseline_metrics.json
mlruns/
mlartifacts/
.onnx_cache/
.airflow_home/
airflow_home/logs/*
!airflow_home/logs/.gitkeep

# DVC local remote/cache (pointers + dvc.lock stay in Git)
.dvc_remote/
.dvc/cache/
.dvc/tmp/

# Secrets / local env
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Terraform / IaC local state and secrets
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
backend.hcl
!backend.hcl.example
**/backend.hcl
!**/backend.hcl.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Keep .terraform.lock.hcl in Git after init for reproducible provider versions.

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Docker / local compose overrides
docker-compose.override.yml

# Local portable tooling (kind.exe, terraform.exe, etc.)
tools/
!tools/.gitkeep

# Audit copy of source (not part of deliverable)
_source_audit/

# Local scanner noise (do not commit)
trivy_failure_log.txt
