"rules.yml:\n    - name: credit-scoring-api-logs\n      interval: 30s\n      rules:\n        - alert: APIErrorLogsDetected\n          expr: |\n            sum(count_over_time({service=\"credit-scoring-api\", level=\"ERROR\"}[2m])) > 0\n          for: 30s\n          labels:\n            alert_source: loki\n            severity: warning\n          annotations:\n            description: Loki observed one or more structured ERROR log lines from service=credit-scoring-api in the last 2 minutes.\n            summary: ERROR-level logs detected for credit-scoring-api\n"
