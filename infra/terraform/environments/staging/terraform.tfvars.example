# Copy to terraform.tfvars (gitignored) — never commit real IDs/secrets.
cloud_id  = "b1gxxxxxxxxxxxxxxxxxxxxxx"
folder_id = "b1gxxxxxxxxxxxxxxxxxxxxxx"
zone      = "ru-central1-a"

name_prefix            = "cs-stg"
artifacts_bucket_name  = "cs-stg-ml-artifacts-UNIQUE-SUFFIX"

# Leave empty until admin CIDRs are approved. Do NOT use 0.0.0.0/0.
k8s_api_allowed_cidrs = []

kubernetes_version = "1.30"
node_count         = 1
node_cores         = 2
node_memory_gb     = 4
node_preemptible   = true
public_master_ip   = false

enable_load_balancer_admin = false
log_retention_days         = 7

# CPU autoscaling off by default (fixed_scale).
cpu_enable_autoscaling = false

# GPU node group OFF — enable only with explicit budget approval (paid).
enable_gpu_node_group = false
# gpu_platform_id = "gpu-standard-v3"
# gpu_count       = 1
# gpu_node_count  = 1
