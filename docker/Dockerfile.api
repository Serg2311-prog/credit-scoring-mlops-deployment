# CPU-only multi-stage image for credit scoring FastAPI (no PyTorch/CUDA).
FROM python:3.12-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt constraints-docker.txt .
# Upgrade pip/setuptools, install runtime deps, then drop pip's vendored CycloneDX
# SBOM (pip/_vendor/bom.cdx.json). Trivy otherwise treats that build-time metadata
# as an installed setuptools@70.3.0 and fails the HIGH gate on CVE-2025-47273.
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install -c constraints-docker.txt -r requirements-api.txt \
    && find /opt/venv -path '*/pip/_vendor/bom.cdx.json' -delete \
    && /opt/venv/bin/python -c "import importlib.metadata as m; v=m.version('setuptools'); assert tuple(map(int, v.split('.')[:3])) >= (78, 1, 1), v"


FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PATH="/opt/venv/bin:$PATH" \
    APP_ENV=docker \
    MODEL_BACKEND=onnx \
    MODEL_VERSION=mlp-onnx-fp32-v1 \
    MODEL_PATH=/app/models/credit_scoring_nn.onnx \
    PREPROCESSOR_PATH=/app/models/preprocessor.joblib \
    PREDICTION_THRESHOLD=0.5 \
    MAX_BATCH_SIZE=256 \
    ORT_INTRA_OP_THREADS=2 \
    ORT_INTER_OP_THREADS=1 \
    EXPECTED_INPUT_DIM=47 \
    LOG_LEVEL=INFO

WORKDIR /app

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/models \
    && chown -R appuser:appuser /app

COPY --from=builder /opt/venv /opt/venv
COPY src ./src
COPY params.yaml ./params.yaml

USER appuser
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live')"

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
